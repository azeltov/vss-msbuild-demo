# --- Foundry / gpt-4.1 path (default backend) ---
FOUNDRY_PROJECT_ENDPOINT="..."
AZURE_OPENAI_DEPLOYMENT="gpt-4.1"

# --- Backend selector: "foundry" (default, gpt-4.1) or "nemotron" ---
MODEL_BACKEND="foundry"

# --- Nemotron NIM path (only used when MODEL_BACKEND=nemotron) ---
# Base URL of the deployed NIM endpoint. The /v1 suffix is correct; the SDK
# appends /chat/completions itself.
NEMOTRON_ENDPOINT_URL="https://<your-nemotron-nim>.<region>.inference.ml.azure.com/v1"
NEMOTRON_API_KEY="<paste-key-from-Foundry-deployment>"
NEMOTRON_MODEL_NAME="nvidia/nemotron-3-super-120b-a12b"

# --- build.nvidia.com (test-only path used by scripts/test_nemotron.py build) ---
# Lets the diagnostic script target NVIDIA's hosted inference API instead of
# a Foundry NIM deployment. Useful when the Foundry NIM is offline or doesn't
# have tool-calling enabled. NOT used by the deployed hosted agent.
NVIDIA_BUILD_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_BUILD_API_KEY="nvapi-<paste-key-from-build.nvidia.com>"
NVIDIA_BUILD_MODEL_NAME="nvidia/nemotron-3-super-120b-a12b"